ARG CONTAINER_REGISTRY
FROM ${CONTAINER_REGISTRY}/library/python-base:3.12-slim

WORKDIR /app

# Web API packages beyond the base image
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Docling for the conversion step, with torch built for CPU. Its models are
# not in the image: a standard step receives them from Thinkube Storage
# (converter/models.py).
COPY requirements-converter.txt .
RUN pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements-converter.txt

COPY app /app/app
COPY converter /app/converter
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["/app/start.sh"]
