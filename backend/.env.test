# Test environment variables
PROJECT_NAME="Test Application"
FRONTEND_URL="http://localhost:8080"
BACKEND_CORS_ORIGINS='["http://localhost:8080"]'

# Test Keycloak settings (not used in tests but required by settings)
KEYCLOAK_URL="https://auth.test.com"
KEYCLOAK_REALM="test"
KEYCLOAK_CLIENT_ID="test-client"
KEYCLOAK_CLIENT_SECRET="test-secret"

# Test database settings - PostgreSQL in cluster
# DATABASE_URL will be constructed in the test script using POSTGRES_PASSWORD
DATABASE_HOST="postgresql-official.postgres.svc.cluster.local"
DATABASE_PORT="5432"
DATABASE_NAME="test_docling"
# DATABASE_USER will be set from ADMIN_USERNAME environment variable

# Test secret key
SECRET_KEY="test-secret-key-for-testing-only"

# Platform services the backend reads at start. The tests replace storage and
# workflows with doubles, so these addresses are never called.
APP_NAME="docling-test"
SEAWEEDFS_ENDPOINT="http://storage.test.invalid:8333"
SEAWEEDFS_ACCESS_KEY="test-access-key"
SEAWEEDFS_SECRET_KEY="test-secret-key"
WORKFLOWS_NAMESPACE="docling-test"
WORKFLOWS_SERVER_URL="http://workflows.test.invalid:2746"
WORKFLOWS_SERVICE_ACCOUNT="docling-test-workflows"
WORKFLOWS_UI_URL="https://argo.test.invalid/workflows/docling-test"
CONTAINER_IMAGE_BACKEND="registry.test.invalid/thinkube/docling-test-backend:latest"
LLM_GATEWAY_URL="http://llm-proxy.test.invalid:8080"
GRANITE_DOCLING_MODEL="ibm-granite/granite-docling-258M"
THINKUBE_API_TOKEN="tk_test"
